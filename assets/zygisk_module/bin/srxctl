#!/system/bin/sh

MODDIR="/data/adb/modules/storage.redirect.x"
CONFIG_DIR="$MODDIR/config"
APPS_DIR="$CONFIG_DIR/apps"
LOGS_DIR="$MODDIR/logs"
RUNTIME_DISABLE_FILE="$MODDIR/.runtime_disabled"
DAEMON_PID_FILE="$LOGS_DIR/.srx_daemon.pid"
BOOT_OK_FILE="$MODDIR/.boot_ok"
BOOT_MODULE_VERSION_FILE="$MODDIR/.boot_module_version"
PENDING_MODULE_DIR="/data/adb/modules_update/storage.redirect.x"
BOOT_PENDING_FILE="$MODDIR/.boot_pending"
HOT_RELOAD_REQUEST_FILE="$LOGS_DIR/.media_provider_hot_reload.request"
HOT_RELOAD_ACK_FILE="$LOGS_DIR/.media_provider_hot_reload.ack"
RUNNING_LOG_FILE="$LOGS_DIR/running.log"

log_ctl() {
  log -p i -t SRXCTL "$*" 2>/dev/null
}

stop_pid_file() {
  pid_file="$1"
  [ -f "$pid_file" ] || return 0
  pid=$(cat "$pid_file" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    wait_until_dead "$pid" 4 25000 || kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$pid_file"
}

wait_until_dead() {
  pid="$1"
  attempts="${2:-10}"
  delay_us="${3:-100000}"
  [ -n "$pid" ] || return 0
  i=0
  while [ "$i" -lt "$attempts" ]; do
    kill -0 "$pid" 2>/dev/null || return 0
    usleep "$delay_us" 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
  return 1
}

run_bounded() {
  seconds="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@" >/dev/null 2>&1 || true
    return 0
  fi
  "$@" >/dev/null 2>&1 &
  pid=$!
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$i" -ge 10 ]; then
      kill -9 "$pid" 2>/dev/null || true
      break
    fi
    usleep 100000 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
}

stop_collectors() {
  for pid_file in \
    "$LOGS_DIR/.monitor_collector.pid" \
    "$LOGS_DIR/.config_event_collector.pid" \
    "$LOGS_DIR/.package_event_collector.pid" \
    "$LOGS_DIR/.running_collector.pid" \
    "$LOGS_DIR/.media_state_collector.pid" \
    "$LOGS_DIR/.app_status_collector.pid" \
    "$LOGS_DIR/.app_status_snapshot.pid" \
    "$LOGS_DIR/.stats_collector.pid"; do
    stop_pid_file "$pid_file"
  done
}

configured_packages() {
  [ -d "$APPS_DIR" ] || return 0
  for config_file in "$APPS_DIR"/*.json; do
    [ -f "$config_file" ] || continue
    basename "$config_file" .json
  done
}

media_provider_packages() {
  pm list packages 2>/dev/null | sed -n 's/^package://p' | grep -E '^(com\.android\.providers\.media|com\.android\.providers\.media\.module|com\.google\.android\.providers\.media\.module)$'
}

protected_package() {
  case "$1" in
    com.storage.redirect.x|com.topjohnwu.magisk|io.github.huskydg.magisk|io.github.vvb2060.magisk|me.weishu.kernelsu|me.weishu.kernelsu.next|io.github.rifsxd.ksunext|com.sukisu.ultra|me.bmax.apatch|me.garfieldhan.apatch.next|io.github.a13e300.ksuwebui|com.dergoogler.mmrl)
      return 0
      ;;
  esac
  return 1
}

media_provider_pids() {
  pidof com.android.providers.media.module com.google.android.providers.media.module com.android.providers.media 2>/dev/null
}

wake_media_provider() {
  run_bounded 1 content query --uri content://media/external/file --projection _id --limit 1 &
  run_bounded 1 content query --uri content://media/internal/file --projection _id --limit 1 &
}

wait_for_media_provider_start() {
  attempts="${1:-50}"
  delay_us="${2:-100000}"
  previous_pids="$3"
  i=0
  while [ "$i" -lt "$attempts" ]; do
    current_pids=$(media_provider_pids)
    for pid in $current_pids; do
      case " $previous_pids " in
        *" $pid "*) ;;
        *) return 0 ;;
      esac
    done
    if [ "$i" -eq 0 ] || [ $((i % 10)) -eq 0 ]; then
      wake_media_provider
    fi
    usleep "$delay_us" 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
  return 1
}

write_media_provider_hot_reload_request() {
  provider_pid="$1"
  request_id="$(date +%s%N 2>/dev/null || true)-$$"
  [ -n "$request_id" ] || request_id="$(cat /proc/uptime 2>/dev/null | tr -d ' .')-$$"
  temp_file="${HOT_RELOAD_REQUEST_FILE}.tmp.$$"
  printf 'request=%s provider_pid=%s\n' "$request_id" "$provider_pid" > "$temp_file" || return 1
  chmod 644 "$temp_file" 2>/dev/null || true
  mv -f "$temp_file" "$HOT_RELOAD_REQUEST_FILE" || return 1
  printf '%s\n' "$request_id"
}

signal_media_provider_hot_reload() {
  provider_pid="$1"
  kill -USR2 "$provider_pid" 2>/dev/null
}

hot_reload_completed_count() {
  provider_pid="$1"
  grep -F "media provider hot reload completed" "$RUNNING_LOG_FILE" 2>/dev/null \
    | grep -F "pid=$provider_pid" 2>/dev/null | wc -l
}

running_app_remount_completed_count() {
  request_id="$1"
  grep -F "running app remount completed request=$request_id " "$RUNNING_LOG_FILE" 2>/dev/null | wc -l
}

wait_for_media_provider_hot_reload() {
  request_id="$1"
  provider_pid="$2"
  before_count="$3"
  attempts="${4:-100}"
  delay_us="${5:-100000}"
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  i=0
  while [ "$i" -lt "$attempts" ]; do
    ack=$(cat "$HOT_RELOAD_ACK_FILE" 2>/dev/null || true)
    if printf '%s\n' "$ack" | grep -Fq "stage=hot_reload_ok request=$request_id pid=$provider_pid boot_id=$boot_id"; then
      return 0
    fi
    current_count=$(hot_reload_completed_count "$provider_pid")
    if [ "$current_count" -gt "$before_count" ] 2>/dev/null; then
      return 0
    fi
    usleep "$delay_us" 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
  return 1
}

request_running_app_remount() {
  required="${1:-1}"
  if ! is_daemon_alive; then
    log_ctl "running app remount skipped: daemon not running"
    [ "$required" = "1" ] && return 1
    return 0
  fi
  request_id="$(date +%s%N 2>/dev/null || true)-$$"
  [ -n "$request_id" ] || request_id="$(cat /proc/uptime 2>/dev/null | tr -d ' .')-$$"
  before_count=$(running_app_remount_completed_count "$request_id")
  daemon_bin="$MODDIR/bin/srx_daemon"
  if [ ! -x "$daemon_bin" ] || ! "$daemon_bin" control "reconcile-running:$request_id" >/dev/null 2>&1; then
    log_ctl "running app remount request failed"
    return 1
  fi
  attempts=100
  i=0
  while [ "$i" -lt "$attempts" ]; do
    current_count=$(running_app_remount_completed_count "$request_id")
    if [ "$current_count" -gt "$before_count" ] 2>/dev/null; then
      log_ctl "running app remount completed request=$request_id"
      return 0
    fi
    usleep 100000 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
  log_ctl "running app remount timed out request=$request_id"
  return 1
}

media_provider_hook_ready() {
  pid="$1"
  boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
  [ -n "$pid" ] && [ -n "$boot_id" ] || return 1
  install_state=$(cat "$LOGS_DIR/.media_hook_install_state" 2>/dev/null)
  printf '%s\n' "$install_state" | grep -Fq "stage=init_ok pid=$pid boot_id=$boot_id "
}

wait_for_media_provider_hook_ready() {
  attempts="${1:-100}"
  delay_us="${2:-100000}"
  i=0
  while [ "$i" -lt "$attempts" ]; do
    for pid in $(media_provider_pids); do
      if media_provider_hook_ready "$pid"; then
        return 0
      fi
    done
    if [ "$i" -eq 0 ] || [ $((i % 10)) -eq 0 ]; then
      wake_media_provider
    fi
    usleep "$delay_us" 2>/dev/null || sleep 0.1
    i=$((i + 1))
  done
  return 1
}

restart_media_provider() {
  require_running_remount="${1:-0}"
  previous_pids=$(media_provider_pids)
  # 应用进程和 MediaProvider 均保持运行，只在 Provider 进程内刷新运行时状态。
  provider_pid=""
  for pid in $previous_pids; do
    provider_pid="$pid"
    break
  done
  if [ -z "$provider_pid" ]; then
    log_ctl "media provider hot reload skipped: provider not running"
    return 1
  fi
  request_id=$(write_media_provider_hot_reload_request "$provider_pid") || {
    log_ctl "media provider hot reload request write failed"
    return 1
  }
  before_count=$(hot_reload_completed_count "$provider_pid")
  if ! signal_media_provider_hot_reload "$provider_pid"; then
    log_ctl "media provider hot reload signal failed pid=$provider_pid"
    return 1
  fi
  if wait_for_media_provider_hot_reload "$request_id" "$provider_pid" "$before_count" 100 100000; then
    log_ctl "media provider hot reload ready pid=$provider_pid"
    ready=0
  else
    log_ctl "media provider hot reload timed out pid=$provider_pid"
    ready=1
  fi
  if [ "$ready" -eq 0 ]; then
    if ! request_running_app_remount "$require_running_remount"; then
      ready=1
    fi
  fi
  start_collectors_if_needed
  return "$ready"
}

is_process_alive() {
  pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

is_pid_file_alive() {
  pid_file="$1"
  [ -f "$pid_file" ] || return 1
  pid=$(cat "$pid_file" 2>/dev/null)
  is_process_alive "$pid"
}

is_verbose_logging_enabled() {
  [ -f "$CONFIG_DIR/global.json" ] || return 1
  grep -Eq '"verbose_logging_enabled"[[:space:]]*:[[:space:]]*true' "$CONFIG_DIR/global.json" 2>/dev/null
}

is_runtime_disabled() {
  [ -f "$RUNTIME_DISABLE_FILE" ] || [ -f "$MODDIR/disable" ]
}

is_managed_temp_path() {
  [ "$1" != "/data/local/tmp/srx_" ] || return 1
  case "$1" in
    /data/local/tmp/srx_*) ;;
    *) return 1 ;;
  esac
  case "$1" in
    *..*) return 1 ;;
  esac
  return 0
}

build_diagnostic_archive() {
  stage="$1"
  archive="$2"
  progress="$3"
  is_managed_temp_path "$stage" || return 64
  is_managed_temp_path "$archive" || return 64
  [ -z "$progress" ] || is_managed_temp_path "$progress" || return 64

  script="$MODDIR/service.d/diagnostic_archive.sh"
  [ -r "$script" ] || return 127
  if [ -n "$progress" ]; then
    /system/bin/sh "$script" "$stage" "$archive" "$progress"
  else
    /system/bin/sh "$script" "$stage" "$archive"
  fi
}

clear_monitor_log() {
  mkdir -p "$LOGS_DIR"
  daemon_bin="$MODDIR/bin/srx_daemon"
  if [ -x "$daemon_bin" ] && "$daemon_bin" control clear-monitor; then
    usleep 100000 2>/dev/null || sleep 0.1
    return 0
  fi
  base="$LOGS_DIR/file_monitor.log"
  for f in "$base".*; do
    suffix="${f##*.}"
    case "$suffix" in
      ''|*[!0-9]*) continue ;;
    esac
    rm -f "$f"
  done
  : > "$LOGS_DIR/file_monitor.log"
  chmod 666 "$LOGS_DIR/file_monitor.log" 2>/dev/null
}

reset_runtime_stats() {
  stats_dir="/data/adb/storage.redirect.x"
  mkdir -p "$stats_dir"
  daemon_bin="$MODDIR/bin/srx_daemon"
  ack_file="$stats_dir/.stats.reset.ok"
  rm -f "$ack_file"
  if [ -x "$daemon_bin" ] && "$daemon_bin" control reset-stats; then
    i=0
    while [ "$i" -lt 20 ]; do
      if [ -f "$ack_file" ]; then
        rm -f "$ack_file"
        return 0
      fi
      usleep 50000 2>/dev/null || sleep 0.05
      i=$((i + 1))
    done
    return 1
  fi
  is_daemon_alive && return 1
  printf 'schema=2\nruntime_activations=0\n' > "$stats_dir/.stats.tmp" || return 1
  chmod 600 "$stats_dir/.stats.tmp" 2>/dev/null
  mv -f "$stats_dir/.stats.tmp" "$stats_dir/stats"
}

is_daemon_alive() {
  is_pid_file_alive "$DAEMON_PID_FILE" || pidof srx_daemon >/dev/null 2>&1
}

start_collectors_if_needed() {
  if is_runtime_disabled; then
    stop_pid_file "$LOGS_DIR/.monitor_collector.pid"
    return 0
  fi

  stop_pid_file "$LOGS_DIR/.monitor_collector.pid"

  if is_pid_file_alive "$LOGS_DIR/.config_event_collector.pid" \
    && is_pid_file_alive "$LOGS_DIR/.package_event_collector.pid"; then
    if is_daemon_alive \
      && { ! is_verbose_logging_enabled \
      || { is_pid_file_alive "$LOGS_DIR/.running_collector.pid" \
        && is_pid_file_alive "$LOGS_DIR/.media_state_collector.pid" \
        && is_pid_file_alive "$LOGS_DIR/.app_status_collector.pid" \
        && is_pid_file_alive "$LOGS_DIR/.app_status_snapshot.pid"; }; }; then
      return 0
    fi
  fi

  if [ -r "$MODDIR/service.sh" ]; then
    sh "$MODDIR/service.sh" >/dev/null 2>&1 &
    log_ctl "service collectors restart requested"
  fi
}

stop_runtime() {
  mkdir -p "$LOGS_DIR" "$CONFIG_DIR" "$APPS_DIR"
  touch "$RUNTIME_DISABLE_FILE"
  chmod 644 "$RUNTIME_DISABLE_FILE" 2>/dev/null
  printf '{"runtime_disabled":true}\n' > "$CONFIG_DIR/runtime_state.json"
  chmod 644 "$CONFIG_DIR/runtime_state.json" 2>/dev/null

  stop_pid_file "$DAEMON_PID_FILE"
  pkill -x srx_daemon >/dev/null 2>&1 || true
  stop_collectors

  restart_media_provider
  log_ctl "runtime stopped"
}

start_runtime() {
  rm -f "$RUNTIME_DISABLE_FILE"
  mkdir -p "$LOGS_DIR" "$CONFIG_DIR" "$APPS_DIR"
  printf '{"runtime_disabled":false}\n' > "$CONFIG_DIR/runtime_state.json"
  chmod 644 "$CONFIG_DIR/runtime_state.json" 2>/dev/null
  if [ -r "$MODDIR/service.sh" ]; then
    sh "$MODDIR/service.sh" >/dev/null 2>&1 &
  fi
  restart_media_provider
  log_ctl "runtime started"
}

status_runtime() {
  if [ -d "$PENDING_MODULE_DIR" ]; then
    echo reboot_required
  elif [ -f "$RUNTIME_DISABLE_FILE" ]; then
    echo disabled
  elif [ -f "$MODDIR/disable" ]; then
    echo disabled
  else
    boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
    boot_ok=$(cat "$BOOT_OK_FILE" 2>/dev/null)
    boot_module_version=$(cat "$BOOT_MODULE_VERSION_FILE" 2>/dev/null)
    module_version=$(sed -n 's/^versionCode=//p; s/^version=//p' "$MODDIR/module.prop" 2>/dev/null | tr '\n' ' ')
    if [ -n "$module_version" ] && [ "$boot_module_version" != "$module_version" ]; then
      echo reboot_required
    elif [ -n "$boot_id" ] && { [ "$boot_ok" = "$boot_id" ] || [ -f "$LOGS_DIR/boot_${boot_id}.marker" ]; }; then
      echo enabled
    else
      echo reboot_required
    fi
  fi
}

case "$1" in
  stop) stop_runtime ;;
  start) start_runtime ;;
  restart) stop_runtime; start_runtime ;;
  remount-running|restart-media|media-restart|hot-reload-media) restart_media_provider 1 ;;
  ensure-collectors) start_collectors_if_needed ;;
  clear-monitor) clear_monitor_log ;;
  reset-stats) reset_runtime_stats ;;
  diagnostic-archive) build_diagnostic_archive "$2" "$3" "$4" ;;
  status|"") status_runtime ;;
  *) echo "用法：srxctl {start|stop|restart|remount-running|ensure-collectors|clear-monitor|reset-stats|diagnostic-archive|status}" >&2; exit 2 ;;
esac
